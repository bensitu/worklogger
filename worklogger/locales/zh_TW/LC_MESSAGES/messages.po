msgstr "驗證資訊（選填）"

msgid "Author"
msgstr "作者"

msgid "Authorization response received. Return to WorkLogger to continue."
msgstr "已收到授權回應。請返回 WorkLogger 繼續。"

msgid "Auto Record"
msgstr "自動記錄"

msgid "Automatic backup"
msgstr "自動備份"

msgid "Automatic goals use planned workdays and daily standard hours. Enabled public holidays follow the selected region."
msgstr "自動目標根據計畫工作日與每日標準工時計算；啟用假日時，採用所選地區的假日。"

msgid "Avatar"
msgstr "頭像"

msgid "Avatar crop"
msgstr "頭像裁剪"

msgid "Average"
msgstr "平均值"

