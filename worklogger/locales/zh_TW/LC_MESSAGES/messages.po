msgstr "行事曆資料"

msgid "Calendar data already exists.\n\nReplace clears previous calendar events before import.\nAppend keeps existing events and adds imported events."
msgstr "已有行事曆資料。\n\n取代會在匯入前清除原有事件。\n附加會保留原有事件並新增匯入的事件。"

msgid "Calendar days"
msgstr "日曆天數"

