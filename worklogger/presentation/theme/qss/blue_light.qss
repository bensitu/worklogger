QWidget {
  background: {{ background }};
  color: {{ text }};
  font-size: 13px;
  font-weight: 400;
  font-family: "Noto Sans", "Segoe UI", sans-serif;
}

QLabel {
  background: transparent;
}

QListWidget#local_model_list_widget,
QListWidget#custom_work_type_list_widget {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 6px;
  padding: 6px;
}

QListWidget#local_model_list_widget::item,
QListWidget#custom_work_type_list_widget::item {
  border-radius: 4px;
  border: 1px solid transparent;
}

QListWidget#local_model_list_widget::item:hover,
QListWidget#custom_work_type_list_widget::item:hover {
  background: {{ accent_dim }};
}

QListWidget#local_model_list_widget::item:selected,
QListWidget#custom_work_type_list_widget::item:selected {
  background: {{ accent }};
  color: #ffffff;
}


QWidget#settings_theme_row_widget,
QWidget#account_avatar_row_widget,
QWidget#account_display_name_editor_widget,
QWidget#time_entry_actions_widget {
  background: transparent;
}

QToolButton#display_name_action_button {
  padding: 8px;
  min-width: 22px;
  max-width: 22px;
  min-height: 22px;
  max-height: 22px;
}

QDialog,
QMainWindow,
QWidget#app_window_central_widget {
  background: {{ background }};
}

QFrame[card="true"],
QFrame#stat_card_frame,
QFrame#report_editor_frame,
QFrame#report_history_frame,
QFrame#analytics_chart_frame,
QFrame#settings_content_frame {
  background: {{ card }};
  border: 1px solid {{ border }};
  border-radius: 8px;
}

QFrame[card="true"]:hover {
  background: {{ card_hover }};
  border-color: {{ border_strong }};
}

QFrame#app_sidebar_frame {
  background: {{ sidebar_background }};
  border-right: 1px solid {{ border }};
}

QLabel#sidebar_avatar_label {
  background: {{ surface_alt }};
  border-radius: 36px;
}

QFrame#app_sidebar_frame QPushButton[nav_item="true"] {
  padding: 10px 8px;
  font-size: 12px;
}

QWidget#app_main_content_widget,
QStackedWidget#app_page_stack_widget,
QWidget#calendar_page_widget,
QWidget#analytics_page_widget,
QWidget#analytics_content_widget,
QWidget#reports_page_widget QWidget#report_history_content_widget,
QWidget#reports_page_widget {
  background: {{ surface }};
}

QFrame#calendar_grid_frame,
QWidget#calendar_scroll_viewport_widget,
QWidget#calendar_records_widget,
QWidget#worklog_manual_tab_widget,
QWidget#worklog_auto_tab_widget,
QTabWidget#worklog_mode_tab_widget,
QTabWidget#worklog_mode_tab_widget QStackedWidget {
  background: {{ surface }};
}

QFrame#calendar_right_panel_frame {
  background: {{ surface }};
  border: none;
  border-left: 1px solid {{ border }};
}

QPushButton#calendar_day_button {
  min-height: 90px;
  padding: 0;
}

QLabel#schedule_records_label {
  padding-top: 10px;
  border-top: 1px solid {{ border }};
}

QFrame#calendar_record_frame {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 4px;
}


QPushButton#calendar_time_entry_button {
  background: {{ surface }};
  padding: 0;
  border-radius: 4px;
  min-height: 0;
}

QPushButton#calendar_time_entry_button:checked {
  border-color: {{ accent }};
  background: {{ card_hover }};
}

QToolButton#clear_time_entry_button, QToolButton#undo_record_change_button {
  padding: 5px 8px;
  min-width: 20px;
  max-width: 20px;
  min-height: 28px;
  max-height: 28px;
  border-radius: 4px;
}
QPushButton#save_worklog_button {
  min-height: 28px;
  max-height: 28px;
  padding: 5px 8px;
}
QWidget#worklog_entry_panel_widget[compact="true"] QPushButton#save_worklog_button,
QWidget#worklog_entry_panel_widget[compact="true"] QToolButton#clear_time_entry_button,
QWidget#worklog_entry_panel_widget[compact="true"] QToolButton#undo_record_change_button {
  min-height: 24px;
  max-height: 24px;
  padding: 2px 8px;
}
QPushButton#add_entry_button,
QPushButton#daily_notes_button {
  min-height: 28px;
  max-height: 28px;
  padding: 5px 8px;
}
QToolButton#delete_record_button, QToolButton#record_actions_button {
  background: transparent;
  border: none;
  padding: 4px;
  min-width: 16px;
  max-width: 16px;
  min-height: 16px;
  max-height: 16px;
  border-radius: 4px;
}
QToolButton#delete_record_button:hover, QToolButton#record_actions_button:hover {
  background: {{ button_hover }};
}
QLabel#calendar_record_marker_label {
  background: {{ accent }};
  border-radius: 3px;
}

QLabel#week_header_label[weekend="true"] {
  color: {{ accent }};
}

QWidget#worklog_entry_panel_widget[compact="true"] QLineEdit,
QWidget#worklog_entry_panel_widget[compact="true"] QComboBox,
QWidget#worklog_entry_panel_widget[compact="true"] QDoubleSpinBox,
QWidget#worklog_entry_panel_widget[compact="true"] QPushButton {
  min-height: 24px;
  padding: 2px 8px;
}

QWidget#worklog_entry_panel_widget[compact="true"] QDoubleSpinBox QLineEdit {
  min-height: 0;
  padding: 0;
  border: none;
}

QToolButton#recent_work_context_button {
    padding: 0px;
}
QToolButton#recent_work_context_button::menu-indicator {
    image: none;
    width: 0px;
}
QToolButton#cancel_processing_button {
    padding: 0px;
}
QToolButton#polish_time_entry_button {
  min-height: 16px;
  max-height: 16px;
  min-width: 16px;
  max-width: 16px;
  padding: 3px;
}

QTabWidget#worklog_mode_tab_widget QWidget#worklog_auto_tab_widget QPushButton {
  min-height: 40px;
  max-height: 40px;
  padding: 6px 8px;
}

QTabWidget#worklog_mode_tab_widget::pane {
  border: none;
}


QFrame#login_form_frame {
  background: {{ surface }};
}

QFrame#login_hero_frame {
  background: #111827;
}

QFrame#login_divider_left_frame,
QFrame#login_divider_right_frame {
  color: {{ border }};
  background: {{ border }};
  max-height: 1px;
}

QFrame#settings_navigation_frame {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 8px;
}

QLabel[role="section_heading"] {
  font-size: 16px;
  font-weight: 600;
}

QLabel[role="title"] {
  color: {{ text }};
  font-size: 24px;
  font-weight: 700;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="secondary"] {
  color: {{ muted_text }};
}

QLabel[badge="true"] {
  color: {{ accent }};
  background: {{ accent_dim }};
  border: 1px solid {{ border_strong }};
  border-radius: 6px;
  padding: 2px 8px;
}

QPushButton,
QToolButton {
  background: {{ button_background }};
  border: 1px solid {{ border }};
  color: {{ text }};
  border-radius: 8px;
  min-height: 28px;
  padding: 5px 14px;
}

QPushButton:hover,
QToolButton:hover {
  background: {{ button_hover }};
  border-color: {{ accent }};
}

QPushButton:disabled,
QToolButton:disabled {
  color: {{ disabled_text }};
  background: {{ surface_alt }};
  border-color: {{ border }};
}

QPushButton[variant="primary"],
QToolButton[variant="primary"] {
  background: {{ accent }};
  color: #ffffff;
  border: 1px solid {{ accent }};
  font-weight: 600;
}

QPushButton[variant="primary"]:hover,
QToolButton[variant="primary"]:hover {
  background: {{ hover }};
  border-color: {{ hover }};
}

QPushButton[variant="ghost"],
QToolButton[variant="ghost"] {
  background: transparent;
  border: 1px solid transparent;
  color: {{ text }};
}

QPushButton[variant="outline"],
QToolButton[variant="outline"] {
  background: {{ surface }};
  border: 1px solid {{ border_strong }};
  color: {{ accent }};
  font-weight: 600;
}

QPushButton[variant]:disabled, QToolButton[variant]:disabled {
  color: {{ disabled_text }};
  background: {{ surface_alt }};
  border-color: {{ border }};
}

QPushButton[variant="danger"] {
  color: {{ danger }};
}

QPushButton[nav_item="true"],
QPushButton[settings_nav_item="true"] {
  background: transparent;
  border: 1px solid transparent;
  color: {{ text }};
  text-align: left;
  padding: 10px 14px;
  font-weight: 500;
}

QPushButton[nav_item="true"]:hover,
QPushButton[settings_nav_item="true"]:hover {
  background: {{ surface_alt }};
  border-color: {{ border }};
}

QPushButton[nav_item="true"][active="true"],
QPushButton[settings_nav_item="true"][active="true"] {
  background: {{ sidebar_active_background }};
  border-left: 3px solid {{ accent }};
  color: {{ accent }};
  font-weight: 600;
}

QPushButton[segment="true"] {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 0;
  padding: 7px 18px;
}

QPushButton[segment="true"][checked="true"] {
  background: {{ accent_dim }};
  color: {{ accent }};
  border-color: {{ accent }};
  font-weight: 600;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDateEdit,
QDateTimeEdit,
QTimeEdit,
QDoubleSpinBox {
  background: {{ input_background }};
  border: 1px solid {{ input_border }};
  color: {{ text }};
  border-radius: 8px;
  min-height: 28px;
  padding: 5px 10px;
}

QDialog#login_dialog QLineEdit,
QDialog#login_dialog QPushButton {
  min-height: 32px;
}

QLineEdit QToolButton {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDoubleSpinBox:focus {
  border-color: {{ accent }};
}

QComboBox::drop-down {
  border: none;
  width: 26px;
}

QComboBox::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 14px;
  height: 14px;
}

QDateEdit::drop-down, QDateTimeEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  border: none;
  width: 26px;
}

QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 14px;
  height: 14px;
}

QDoubleSpinBox::up-button, QSpinBox::up-button, QTimeEdit::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 22px;
  border: none;
}

QDoubleSpinBox::down-button, QSpinBox::down-button, QTimeEdit::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 22px;
  border: none;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow, QTimeEdit::up-arrow {
  image: url("{{ icons_root }}/chevron-up.svg");
  width: 12px;
  height: 12px;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow, QTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 12px;
  height: 12px;
}

QSpinBox#local_context_spin_box {
  min-height: 18px;
  padding: 2px 8px;
}

QTabWidget#worklog_mode_tab_widget::pane {
  border: none;
  padding-top: 8px;
}

QTabBar#worklog_mode_selector_widget {
  background: {{ surface_alt }};
  border: 1px solid {{ border }};
  border-radius: 8px;
}

QTabBar#worklog_mode_selector_widget::tab {
  background: transparent;
  color: {{ muted_text }};
  border: 1px solid transparent;
  border-radius: 5px;
  margin: 3px;
  min-height: 20px;
  padding: 4px;
  font-size: 12px;
  font-weight: 500;
}

QTabBar#worklog_mode_selector_widget::tab:hover {
  color: {{ text }};
  background: {{ card_hover }};
}

QTabBar#worklog_mode_selector_widget::tab:selected {
  background: {{ surface }};
  color: {{ accent }};
  border-color: {{ border_strong }};
  font-weight: 600;
}

QMenu {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 8px;
  padding: 4px;
}

QMenu::item {
  padding: 7px 28px 7px 12px;
}

QMenu::item:selected {
  background: {{ sidebar_active_background }};
  color: {{ accent }};
}

QScrollArea {
  border: none;
  background: transparent;
}

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px;
}

QScrollBar::handle:vertical {
  background: {{ border_strong }};
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  border: none;
  background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: transparent;
}

QWidget#settings_page_widget, QWidget#settings_scroll_content_widget {
  background: {{ surface }};
}

QWidget#settings_switch_row_widget, QWidget#settings_about_widget {
  background: transparent;
}

QLabel#settings_section_title_label {
  font-size: 16px;
  font-weight: 600;
}

QLineEdit#account_name_line_edit, QLineEdit#account_id_line_edit, QLineEdit#account_role_line_edit {
  background: {{ surface_alt }};
}

QFrame#settings_separator_frame {
  background: {{ border }};
  border: none;
  max-height: 1px;
}

QTabWidget::pane {
  border: 1px solid {{ border }};
  border-radius: 8px;
}

QTabBar::tab {
  background: {{ surface }};
  border: 1px solid {{ border }};
  padding: 8px 16px;
}

QTabBar::tab:selected {
  color: {{ accent }};
  border-bottom: 2px solid {{ accent }};
}


QLabel#calendar_month_title_label, QLabel#report_period_label {
  font-size: 18px;
  font-weight: 600;
}

QPushButton[page_tab="true"] {
  background: transparent;
  border: none;
  border-bottom: 1px solid {{ border }};
  border-radius: 0;
  padding: 10px 16px;
  color: {{ muted_text }};
}

QPushButton[page_tab="true"][checked="true"] {
  background: transparent;
  color: {{ accent }};
  border-bottom: 3px solid {{ accent }};
  font-weight: 600;
}

QFrame#report_period_separator_frame {
  background: {{ border }};
  border: none;
}

QLabel#report_title_label, QLabel#report_history_title_label {
  font-size: 16px;
  font-weight: 600;
}

QLabel#report_history_month_label, QLabel#analytics_chart_title_label,
QLabel#donut_title_label, QLabel#dot_title_label, QLabel#overtime_title_label {
  font-weight: 600;
}

QPushButton#report_history_item_button {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 6px;
  text-align: left;
  padding: 10px 12px;
}

QPushButton#report_history_item_button[active="true"] {
  background: {{ sidebar_active_background }};
  border: 1px solid {{ accent }};
  color: {{ accent }};
}

QPushButton#report_history_item_button:hover {
  border-color: {{ accent }};
}

QLabel#donut_value_label, QLabel#dot_value_label, QLabel#overtime_value_label,
QLabel#daily_average_value_label {
  font-size: 21px;
  font-weight: 600;
}

QLabel#donut_caption_label, QLabel#dot_caption_label, QLabel#overtime_caption_label,
QLabel#daily_average_comparison_label {
  font-size: 11px;
}

QToolButton#copy_report_button {
  min-width: 20px;
  max-width: 20px;
  min-height: 28px;
  max-height: 28px;
  padding: 5px 9px;
}

QToolButton[export_menu="true"] {
  padding-right: 28px;
}

QToolButton[export_menu="true"]::menu-indicator {
  image: url("{{ icons_root }}/chevron-down.svg");
  subcontrol-origin: padding;
  subcontrol-position: center right;
  right: 8px;
  width: 12px;
  height: 12px;
}
