/* Popup menus and their selection states. */

QMenu {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 8px;
  padding: 4px;
}

QMenu::item {
  padding: 7px 28px 7px 12px;
}

QMenu::item:selected {
  background: {{ sidebar_active_background }};
  color: {{ accent }};
}
