/* Authentication and semantic text roles. */

QFrame#login_hero_frame {
  background: {{ login_hero_background }};
}

QFrame#login_divider_left_frame,
QFrame#login_divider_right_frame {
  color: {{ border }};
  background: {{ border }};
  max-height: 1px;
}

QFrame#settings_navigation_frame {
  background: {{ navigation_fill }};
  border: 1px solid {{ panel_border }};
  border-radius: 8px;
}

QLabel[role="section_heading"],
QLabel[role="credential_success"],
QPushButton#date_picker_button,
QLabel#settings_section_title_label,
QLabel#report_title_label,
QLabel#report_history_title_label {
  font-size: 16px;
  font-weight: 600;
}

QLabel[role="credential_success"] {
  color: {{ success }};
}

QLabel[role="error"] {
  color: {{ danger }};
}

QLabel[role="account_identity"] {
  font-size: 14px;
  font-weight: 500;
}

QLabel#recovery_key_label {
  background: {{ input_fill }};
  border: 1px solid {{ field_border }};
  border-radius: 8px;
  padding: 10px;
  font-family: "Consolas", "Menlo", monospace;
  font-size: 14px;
  font-weight: 500;
}

QDialog[credential_form="true"] QLabel[role="caption"],
QDialog[credential_form="true"] QWidget > QLabel[role="secondary"] {
  font-size: 12px;
}

QLabel[role="title"] {
  color: {{ text }};
  font-size: 24px;
  font-weight: 700;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="metric_caption"],
QLabel[role="secondary"] {
  color: {{ muted_text }};
}

QLabel[badge="true"] {
  color: {{ accent }};
  background: {{ accent_dim }};
  border: 1px solid {{ border_strong }};
  border-radius: 6px;
  padding: 2px 8px;
}
