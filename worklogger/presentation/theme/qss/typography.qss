/* Semantic text roles and shared heading sizes. */

QLabel[role="section_heading"],
QLabel[role="credential_success"],
QPushButton#date_picker_button,
QLabel#settings_section_title_label,
QLabel#report_title_label,
QLabel#report_history_title_label {
  font-size: 16px;
  font-weight: 600;
}

QLabel[role="credential_success"] {
  color: {{ success }};
}

QLabel[role="error"] {
  color: {{ danger }};
}

QLabel[role="account_identity"] {
  font-size: 14px;
  font-weight: 500;
}

QLabel[role="title"] {
  color: {{ text }};
  font-size: 24px;
  font-weight: 700;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="metric_caption"],
QLabel[role="secondary"] {
  color: {{ muted_text }};
}

QLabel[badge="true"] {
  color: {{ accent }};
  background: {{ accent_dim }};
  border: 1px solid {{ border_strong }};
  border-radius: 6px;
  padding: 2px 8px;
}

QLabel#calendar_month_title_label,
QPushButton#calendar_month_title_label,
QLabel#report_period_label,
QLabel[data_metric="true"] {
  font-size: 18px;
  font-weight: 600;
}

QLabel#report_history_month_label,
QLabel#analytics_chart_title_label,
QLabel[role="metric_title"] {
  font-weight: 600;
}

QLabel[role="metric_value"],
QLabel#daily_average_value_label {
  font-size: 21px;
  font-weight: 600;
}

QLabel[role="metric_caption"],
QLabel#daily_average_comparison_label {
  font-size: 11px;
}
