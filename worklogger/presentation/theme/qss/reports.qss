/* Report history, previews, and reporting actions. */

QPushButton#report_history_item_button {
  border: 1px solid {{ row_border }};
  border-radius: 6px;
  text-align: left;
  padding: 10px 12px;
}

QPushButton#report_history_item_button[active="true"] {
  font-weight: 500;
  background: {{ sidebar_active_background }};
  border: 1px solid {{ accent }};
  color: {{ accent }};
}

QTextEdit#report_revision_preview_text_edit {
  background: {{ surface }};
  border: none;
  border-radius: 6px;
  padding: 0;
}
