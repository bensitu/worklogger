/* Shared tabs with recording and management variants. */

QTabWidget::pane {
  background: {{ tab_pane_fill }};
  border: 1px solid {{ panel_border }};
  border-radius: {{ panel_radius }};
}

QTabBar::tab {
  background: {{ tab_fill }};
  border: 1px solid {{ panel_border }};
  padding: 8px 16px;
}

QTabBar::tab:selected {
  color: {{ accent }};
  border-bottom: 2px solid {{ accent }};
}

QTabBar::tab:hover:enabled {
  background: {{ tab_hover_fill }};
}

QTabWidget#worklog_mode_tab_widget::pane {
  border: none;
  padding-top: 8px;
}

QTabWidget#classification_section_tab_widget::pane {
  background: transparent;
  border: none;
}

QTabBar[tab_style="segmented"] {
  qproperty-drawBase: 0;
  background: {{ surface_alt }};
  border: 1px solid {{ border }};
  border-radius: {{ control_radius }};
}

QTabBar[tab_style="segmented"]::tab {
  background: transparent;
  color: {{ muted_text }};
  border: 1px solid transparent;
  border-radius: {{ segmented_tab_radius }};
  margin: 3px;
  min-height: 24px;
  padding: 4px 14px;
  font-size: 13px;
  font-weight: 500;
}

QTabBar[tab_style="segmented"]::tab:hover:enabled {
  color: {{ text }};
  background: {{ card_hover }};
}

QTabBar[tab_style="segmented"]::tab:selected,
QTabBar[tab_style="segmented"]::tab:selected:hover:enabled {
  background: {{ accent_dim }};
  color: {{ accent }};
  border-color: {{ accent }};
  font-weight: 600;
}

QTabBar[tab_style="segmented"][density="compact"]::tab {
  min-height: 20px;
  padding: 4px;
  font-size: 12px;
}

QTabBar[tab_style="segmented"][selection_style="subtle"]::tab:selected,
QTabBar[tab_style="segmented"][selection_style="subtle"]::tab:selected:hover:enabled {
  background: {{ button_fill }};
  border-color: {{ button_border }};
}

QTabBar[tab_style="segmented"][selection_style="subtle"]::tab:selected:hover:enabled {
  background: {{ card_hover }};
}

QTabWidget#project_editor_tab_widget::pane,
QTabWidget#report_revision_tab_widget::pane {
  background: {{ editor_pane_fill }};
  border: 1px solid {{ panel_border }};
  border-radius: {{ editor_panel_radius }};
  top: 8px;
}

QWidget[editor_page="true"] {
  background: {{ editor_fill }};
  border-color: {{ panel_border }};
  border-radius: {{ editor_panel_radius }};
}

QTabBar[tab_style="underline"] {
  qproperty-drawBase: 0;
  background: transparent;
  border: none;
}

QTabBar[tab_style="underline"]::tab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 18px;
  margin-right: 8px;
  color: {{ muted_text }};
  font-weight: 500;
}

QTabBar[tab_style="underline"]::tab:selected {
  color: {{ accent }};
  border-bottom-color: {{ accent }};
  font-weight: 600;
}
