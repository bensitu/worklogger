/* Shared tabs with recording and management variants. */

QTabWidget::pane {
  background: {{ tab_pane_fill }};
  border: 1px solid {{ panel_border }};
  border-radius: {{ panel_radius }};
}

QTabBar::tab {
  background: {{ tab_fill }};
  border: 1px solid {{ panel_border }};
  padding: 8px 16px;
}

QTabBar::tab:selected {
  color: {{ accent }};
  border-bottom: 2px solid {{ accent }};
}

QTabBar::tab:hover:enabled {
  background: {{ tab_hover_fill }};
}

QTabWidget#worklog_mode_tab_widget::pane {
  border: none;
  padding-top: 8px;
}

QTabWidget#classification_section_tab_widget::pane {
  background: transparent;
  border: none;
}

QTabBar#worklog_mode_selector_widget {
  background: {{ surface_alt }};
  border: 1px solid {{ border }};
  border-radius: {{ control_radius }};
}

QTabBar#worklog_mode_selector_widget::tab {
  background: transparent;
  color: {{ muted_text }};
  border: 1px solid transparent;
  border-radius: 5px;
  margin: 3px;
  min-height: 20px;
  padding: 4px;
  font-size: 12px;
  font-weight: 500;
}

QTabBar#worklog_mode_selector_widget::tab:hover:enabled {
  color: {{ text }};
  background: {{ card_hover }};
}

QTabBar#worklog_mode_selector_widget::tab:selected {
  background: {{ button_fill }};
  color: {{ accent }};
  border-color: {{ button_border }};
  font-weight: 600;
}

QTabBar#worklog_mode_selector_widget::tab:selected:hover:enabled {
  color: {{ accent }};
}

QTabWidget#project_editor_tab_widget::pane,
QTabWidget#report_revision_tab_widget::pane {
  background: {{ editor_pane_fill }};
  border: 1px solid {{ panel_border }};
  border-radius: 6px;
  top: 8px;
}

QWidget[editor_page="true"] {
  background: {{ editor_fill }};
  border-color: {{ panel_border }};
  border-radius: 6px;
}

QTabBar[tab_style="underline"]::tab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 18px;
  margin-right: 8px;
  color: {{ muted_text }};
  font-weight: 500;
}

QTabBar[tab_style="underline"]::tab:selected {
  color: {{ accent }};
  border-bottom-color: {{ accent }};
  font-weight: 600;
}
