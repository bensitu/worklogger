/* Input fields, focus states, and popup indicators. */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QFrame[role="processing_input"],
QComboBox,
QAbstractSpinBox {
  background: {{ input_fill }};
  border: 1px solid {{ field_border }};
  color: {{ text }};
  border-radius: {{ control_radius }};
  min-height: {{ control_min_height }};
  padding: {{ control_padding_vertical }} {{ field_padding_horizontal }};
}

QLineEdit:read-only {
  background: {{ readonly_fill }};
}

QPlainTextEdit[role="readonly_location_path"] {
  background: transparent;
  color: {{ muted_text }};
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
}

QLineEdit:hover:enabled:!read-only:!focus,
QTextEdit:hover:enabled:!read-only:!focus,
QPlainTextEdit:hover:enabled:!read-only:!focus,
QComboBox:hover:enabled:!focus,
QAbstractSpinBox:hover:enabled:!read-only:!focus {
  border-color: {{ border_strong }};
}

QComboBox::drop-down,
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
  border: none;
  width: 26px;
}

QComboBox[entry_type_picker="true"],
QWidget#worklog_entry_panel_widget[compact="true"] QComboBox[entry_type_picker="true"] {
  padding-right: 2px;
}

QComboBox[entry_type_picker="true"]::drop-down {
  width: 18px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 14px;
  height: 14px;
}

QDateEdit::drop-down,
QDateTimeEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
}

QDoubleSpinBox::up-button,
QSpinBox::up-button,
QTimeEdit::up-button,
QDoubleSpinBox::down-button,
QSpinBox::down-button,
QTimeEdit::down-button {
  subcontrol-origin: border;
  width: 22px;
  border: none;
}

QDoubleSpinBox::up-button,
QSpinBox::up-button,
QTimeEdit::up-button {
  subcontrol-position: top right;
}

QDoubleSpinBox::down-button,
QSpinBox::down-button,
QTimeEdit::down-button {
  subcontrol-position: bottom right;
}

QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow,
QTimeEdit::up-arrow {
  image: url("{{ icons_root }}/chevron-up.svg");
  width: 12px;
  height: 12px;
}

QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow,
QTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 12px;
  height: 12px;
}
