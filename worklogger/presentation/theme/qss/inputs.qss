/* Input fields, focus states, and popup indicators. */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QAbstractSpinBox {
  background: {{ input_fill }};
  border: 1px solid {{ field_border }};
  color: {{ text }};
  border-radius: 8px;
  min-height: 28px;
  padding: 5px 10px;
}

QLineEdit QToolButton {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
}

QLineEdit:hover:enabled:!read-only:!focus,
QTextEdit:hover:enabled:!read-only:!focus,
QPlainTextEdit:hover:enabled:!read-only:!focus,
QComboBox:hover:enabled:!focus,
QAbstractSpinBox:hover:enabled:!read-only:!focus {
  border-color: {{ border_strong }};
}

QCheckBox:hover:enabled,
QRadioButton:hover:enabled {
  color: {{ accent }};
}

QRadioButton#work_schedule_choice_button {
  spacing: 0;
  padding-left: 6px;
}

QRadioButton#work_schedule_choice_button::indicator {
  width: 14px;
  height: 14px;
  background: {{ input_fill }};
  border: 1px solid {{ field_border }};
  border-radius: 8px;
}

QRadioButton#work_schedule_choice_button::indicator:checked {
  background: {{ accent }};
  border-color: {{ accent }};
}

QRadioButton#work_schedule_choice_button::indicator:hover:enabled {
  border-color: {{ accent }};
}

QRadioButton#work_schedule_choice_button::indicator:disabled {
  background: {{ disabled_background }};
  border-color: {{ border }};
}

QRadioButton#work_schedule_choice_button::indicator:checked:disabled {
  background: {{ disabled_text }};
}

QComboBox::drop-down {
  border: none;
  width: 26px;
}

QComboBox[entry_type_picker="true"],
QWidget#worklog_entry_panel_widget[compact="true"] QComboBox[entry_type_picker="true"] {
  padding-right: 2px;
}

QComboBox[entry_type_picker="true"]::drop-down {
  width: 18px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 14px;
  height: 14px;
}

QDateEdit::drop-down,
QDateTimeEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  border: none;
  width: 26px;
}

QDoubleSpinBox::up-button,
QSpinBox::up-button,
QTimeEdit::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 22px;
  border: none;
}

QDoubleSpinBox::down-button,
QSpinBox::down-button,
QTimeEdit::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 22px;
  border: none;
}

QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow,
QTimeEdit::up-arrow {
  image: url("{{ icons_root }}/chevron-up.svg");
  width: 12px;
  height: 12px;
}

QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow,
QTimeEdit::down-arrow {
  image: url("{{ icons_root }}/chevron-down.svg");
  width: 12px;
  height: 12px;
}

QSpinBox#local_context_spin_box {
  min-height: 18px;
  padding: 2px 8px;
}

QSlider::groove:horizontal {
  height: 4px;
  border-radius: 2px;
  background: {{ border }};
}

QSlider::sub-page:horizontal {
  background: {{ accent }};
  border-radius: 2px;
}

QSlider::handle:horizontal {
  width: 16px;
  margin: -6px 0;
  border: 1px solid {{ accent }};
  border-radius: 8px;
  background: {{ surface }};
}

QSlider::handle:horizontal:focus:enabled {
  border: 2px solid {{ accent }};
}

QSlider::handle:horizontal:hover:enabled {
  background: {{ accent_dim }};
  border-color: {{ hover }};
}
