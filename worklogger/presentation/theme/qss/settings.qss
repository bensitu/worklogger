/* Settings controls and account editing actions. */

QWidget#cloud_backup_panel_widget QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid {{ field_border }};
  border-radius: 3px;
  background: {{ input_fill }};
}

QWidget#cloud_backup_panel_widget QCheckBox::indicator:checked {
  image: url("{{ icons_root }}/check.svg");
  border-color: {{ accent }};
  background: {{ accent }};
}

QWidget#cloud_backup_panel_widget QCheckBox::indicator:hover:enabled {
  border-color: {{ accent }};
}

QWidget#cloud_backup_panel_widget QCheckBox::indicator:disabled {
  border-color: {{ border }};
}

QToolButton#display_name_action_button {
  padding: 8px;
  min-width: 22px;
  max-width: 22px;
  min-height: 22px;
  max-height: 22px;
}
