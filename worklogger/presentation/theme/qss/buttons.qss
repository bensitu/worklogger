/* Action roles and interaction states. */

QPushButton,
QToolButton {
  background: {{ button_fill }};
  border: 1px solid {{ button_border }};
  color: {{ text }};
  font-weight: 500;
  border-radius: 8px;
  min-height: 28px;
  padding: 5px 14px;
}

QPushButton:hover:enabled,
QToolButton:hover:enabled,
QPushButton[segment="true"]:hover:enabled {
  background: {{ button_hover_fill }};
  border-color: {{ accent }};
}

QPushButton[variant="primary"],
QToolButton[variant="primary"] {
  background: {{ accent }};
  color: {{ highlighted_text }};
  border: 1px solid {{ accent }};
  font-weight: 600;
}

QPushButton[variant="primary"]:hover:enabled,
QToolButton[variant="primary"]:hover:enabled {
  background: {{ hover }};
  border-color: {{ hover }};
}

QPushButton[variant="ghost"],
QToolButton[variant="ghost"] {
  background: transparent;
  border: 1px solid transparent;
  color: {{ text }};
  font-weight: 400;
}

QPushButton[variant="ghost"]:hover:enabled,
QToolButton[variant="ghost"]:hover:enabled {
  background: {{ button_hover_fill }};
  border-color: transparent;
}

QPushButton[variant="danger"],
QToolButton[variant="danger"] {
  color: {{ danger }};
  font-weight: 500;
}

QPushButton[variant="danger"]:hover:enabled,
QToolButton[variant="danger"]:hover:enabled {
  border-color: {{ danger }};
}

QPushButton#calendar_time_entry_button:hover:enabled,
QPushButton#report_history_item_button:hover:enabled {
  background: {{ row_hover_fill }};
  border-color: {{ accent }};
}

QPushButton#calendar_time_entry_button:checked:hover:enabled,
QPushButton#report_history_item_button[active="true"]:hover:enabled {
  background: {{ button_hover }};
}
