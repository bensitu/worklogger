QLabel#calendar_month_title_label,
QLabel#report_period_label {
  font-size: 18px;
  font-weight: 600;
}

QPushButton[page_tab="true"] {
  background: transparent;
  border: none;
  border-bottom: 1px solid {{ border }};
  border-radius: 0;
  padding: 10px 16px;
  color: {{ muted_text }};
}

QPushButton[page_tab="true"][checked="true"] {
  background: transparent;
  color: {{ accent }};
  border-bottom: 3px solid {{ accent }};
  font-weight: 600;
}

QPushButton[page_tab="true"]:hover:enabled {
  background: {{ button_hover }};
  border-bottom-color: {{ accent }};
}

QFrame#report_period_separator_frame {
  background: {{ panel_border }};
  border: none;
}

QLabel#report_history_month_label,
QLabel#analytics_chart_title_label,
QLabel#donut_title_label,
QLabel#dot_title_label,
QLabel#overtime_title_label {
  font-weight: 600;
}

QPushButton#report_history_item_button {
  font-weight: 400;
  background: {{ row_fill }};
  border: 1px solid {{ row_border }};
  border-radius: 6px;
  text-align: left;
  padding: 10px 12px;
}

QPushButton#report_history_item_button[active="true"] {
  font-weight: 500;
  background: {{ sidebar_active_background }};
  border: 1px solid {{ accent }};
  color: {{ accent }};
}

QLabel#donut_value_label,
QLabel#dot_value_label,
QLabel#overtime_value_label,
QLabel#daily_average_value_label {
  font-size: 21px;
  font-weight: 600;
}

QLabel#donut_caption_label,
QLabel#dot_caption_label,
QLabel#overtime_caption_label,
QLabel#daily_average_comparison_label {
  font-size: 11px;
}

QToolButton#copy_report_button,
QToolButton#note_copy_button,
QToolButton#note_export_button,
QToolButton#note_reload_button {
  min-width: 20px;
  max-width: 20px;
  min-height: 28px;
  max-height: 28px;
  padding: 5px 9px;
}

QToolButton[export_menu="true"] {
  padding-right: 28px;
}

QToolButton[export_menu="true"]::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  right: 8px;
  width: 12px;
  height: 12px;
}

QComboBox#analytics_period_combo,
QPushButton#analytics_projects_button,
QToolButton#analytics_export_button {
  min-height: 30px;
  max-height: 30px;
  padding-top: 6px;
  padding-bottom: 6px;
}
