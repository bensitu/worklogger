/* Tables, trees, lists, and scroll-area surfaces. */

QTableView,
QTreeView {
  background: {{ table_fill }};
  alternate-background-color: {{ table_alternate }};
  border: 1px solid {{ table_border }};
}

QHeaderView::section {
  background: {{ header_fill }};
  border: none;
  border-bottom: 1px solid {{ table_border }};
  border-right: 1px solid {{ table_border }};
  padding: 4px 6px;
}

QHeaderView[sectionsClickable="true"]::section:hover:enabled {
  background: {{ button_hover_fill }};
  border-bottom-color: {{ accent }};
}

QListWidget[list_style="preview"] {
  background: {{ surface }};
  border: 1px solid {{ border }};
  border-radius: 6px;
  padding: 6px;
}

QListWidget[list_style="preview"]::item {
  border-radius: {{ item_radius }};
  border: 1px solid transparent;
}

QAbstractItemView::item:hover:enabled:!selected {
  background: {{ accent_dim }};
}

QListWidget[list_style="preview"]::item:selected,
QTreeWidget[data_browser="true"]::item:selected {
  background: {{ accent }};
  color: {{ highlighted_text }};
}

QListWidget[selection_style="subtle"]::item:selected {
  background: {{ accent_dim }};
  border-color: {{ accent }};
  color: {{ text }};
}

QTreeWidget[data_browser="true"]::item {
  min-height: 18px;
  padding: 6px 8px;
  border-bottom: 1px solid {{ table_border }};
}

QTreeWidget[data_browser="true"] QHeaderView::section {
  background: {{ surface_alt }};
  color: {{ muted_text }};
  border: none;
  border-bottom: 1px solid {{ table_border }};
  padding: 8px 10px;
  font-weight: 500;
}

QScrollArea {
  border: none;
  background: transparent;
}
