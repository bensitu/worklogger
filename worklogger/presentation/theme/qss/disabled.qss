/* Disabled states preserve control geometry and role typography. */

QComboBox:disabled,
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QAbstractSpinBox:disabled,
QLineEdit#account_name_line_edit:disabled,
QLineEdit#account_id_line_edit:disabled,
QLineEdit#account_role_line_edit:disabled,
QTextEdit#report_revision_preview_text_edit:disabled,
QPushButton:disabled,
QToolButton:disabled,
QPushButton[variant]:disabled,
QToolButton[variant]:disabled,
QPushButton[nav_item]:disabled,
QPushButton[settings_nav_item]:disabled,
QPushButton[segment]:disabled,
QPushButton[page_tab]:disabled,
QPushButton#report_history_item_button:disabled,
QPushButton#report_history_item_button[active]:disabled,
QPushButton#calendar_time_entry_button:disabled,
QTabBar::tab:disabled,
QTabBar#worklog_mode_selector_widget::tab:disabled,
QTabBar#worklog_mode_selector_widget::tab:selected:disabled,
QTabBar[tab_style="underline"]::tab:disabled,
QTabBar[tab_style="segmented"]::tab:disabled,
QTabBar[tab_style="segmented"]::tab:selected:disabled,
QHeaderView::section:disabled,
QTreeWidget[data_browser] QHeaderView::section:disabled {
  color: {{ disabled_text }};
  background: {{ disabled_background }};
  border-color: {{ border }};
}

QPushButton[variant="ghost"]:disabled,
QToolButton[variant="ghost"]:disabled {
  background: transparent;
  border-color: transparent;
}

QLabel:disabled,
QLabel[role]:disabled,
QLabel[badge]:disabled,
QLabel#week_header_label:disabled,
QLabel#date_picker_holiday_status_label:disabled,
QCheckBox:disabled,
QRadioButton:disabled {
  color: {{ disabled_text }};
}

QAbstractItemView:disabled,
QListWidget[list_style="preview"]:disabled {
  color: {{ disabled_text }};
  background: {{ disabled_background }};
  alternate-background-color: {{ disabled_background }};
  border-color: {{ border }};
}

QAbstractItemView::item:selected:disabled,
QListWidget[list_style="preview"]::item:selected:disabled,
QTreeWidget[data_browser]::item:selected:disabled {
  color: {{ disabled_text }};
  background: {{ border }};
  border-color: {{ border }};
}

QMenu::item:disabled,
QMenu::item:selected:disabled {
  color: {{ disabled_text }};
  background: transparent;
}

QSlider::sub-page:horizontal:disabled {
  background: {{ border }};
}

QSlider::handle:horizontal:disabled {
  background: {{ disabled_background }};
  border-color: {{ border_strong }};
}

QLabel#calendar_record_marker_label:disabled,
QRadioButton#work_schedule_choice_button::indicator:checked:disabled,
QRadioButton#database_recovery_choice_button::indicator:checked:disabled {
  background: {{ disabled_text }};
}

QRadioButton#work_schedule_choice_button::indicator:disabled,
QRadioButton#database_recovery_choice_button::indicator:disabled {
  background: {{ disabled_background }};
  border-color: {{ border }};
}
